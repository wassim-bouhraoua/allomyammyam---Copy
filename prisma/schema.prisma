generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String
  firstName        String
  lastName         String
  phoneNumber      String?
  role             Role          @default(USER)
  avatar           String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  defaultAddressId String?
  deletedAt        DateTime?
  addresses        Address[]
  cart             Cart?
  chefProfile      ChefProfile?
  dishReviews      DishReview[]
  favorites        Favorite[]
  orderReviews     OrderReview[]
  orders           Order[]       @relation("CustomerOrders")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String   @default("Home")
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String   @default("MA")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model ChefProfile {
  id            String     @id @default(cuid())
  userId        String     @unique
  displayName   String
  bio           String?
  specialties   String[]
  averageRating Float      @default(0)
  status        ChefStatus @default(PENDING)
  isAvailable   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  avatarUrl     String?
  bannerUrl     String?
  city          String?
  deletedAt     DateTime?
  totalReviews  Int        @default(0)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishes        Dish[]
  orders        Order[]    @relation("ChefOrders")

  @@index([userId])
  @@index([status])
  @@index([isAvailable])
  @@index([city])
  @@index([deletedAt])
  @@map("chef_profiles")
}

model Dish {
  id              String       @id @default(cuid())
  chefId          String
  name            String
  description     String?
  price           Decimal      @db.Decimal(10, 2)
  category        DishCategory
  imageUrl        String?
  averageRating   Float        @default(0)
  isAvailable     Boolean      @default(true)
  preparationTime Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  stockCount      Int?
  tags            String[]
  totalReviews    Int          @default(0)
  calories        Int?
  protein         Int?
  carbs           Int?
  fat             Int?
  sugar           Int?
  cartItems       CartItem[]
  images          DishImage[]
  chef            ChefProfile  @relation(fields: [chefId], references: [id], onDelete: Cascade)
  favorites       Favorite[]
  orderItems      OrderItem[]

  @@index([chefId])
  @@index([category])
  @@index([isAvailable])
  @@index([averageRating])
  @@index([deletedAt])
  @@index([chefId, isAvailable])
  @@map("dishes")
}

model DishImage {
  id        String   @id @default(cuid())
  dishId    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@map("dish_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  dishId    String
  createdAt DateTime @default(now())
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dishId])
  @@index([userId])
  @@index([dishId])
  @@map("favorites")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  dishId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id])

  @@unique([cartId, dishId])
  @@index([cartId])
  @@index([dishId])
  @@map("cart_items")
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  chefId          String
  status          OrderStatus  @default(CREATED)
  totalAmount     Decimal      @db.Decimal(10, 2)
  deliveryAddress String
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  cancelReason    String?
  deliveryFee     Decimal?     @db.Decimal(10, 2)
  scheduledAt     DateTime?
  orderItems      OrderItem[]
  review          OrderReview?
  chef            ChefProfile  @relation("ChefOrders", fields: [chefId], references: [id])
  customer        User         @relation("CustomerOrders", fields: [userId], references: [id])

  @@index([userId])
  @@index([chefId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("orders")
}

model OrderItem {
  id         String      @id @default(cuid())
  orderId    String
  dishId     String
  quantity   Int
  unitPrice  Decimal     @db.Decimal(10, 2)
  totalPrice Decimal     @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  dishName   String
  dishReview DishReview?
  dish       Dish        @relation(fields: [dishId], references: [id])
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

model OrderReview {
  id            String   @id @default(cuid())
  orderId       String   @unique
  userId        String
  overallRating Float
  serviceRating Float
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
  @@map("order_reviews")
}

model DishReview {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  userId      String
  rating      Float
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([orderItemId])
  @@index([userId])
  @@index([createdAt])
  @@map("dish_reviews")
}

enum Role {
  USER
  CHEF
  ADMIN
}

enum ChefStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  CREATED
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DishCategory {
  APPETIZER
  SOUP
  SALAD
  MAIN_COURSE
  PASTA
  RICE_AND_GRAINS
  SEAFOOD
  MEAT
  VEGETARIAN
  VEGAN
  PIZZA
  BURGER
  SANDWICH
  WRAP
  SUSHI
  ASIAN
  MEDITERRANEAN
  MIDDLE_EASTERN
  AFRICAN
  LATIN_AMERICAN
  BREAKFAST
  BRUNCH
  DESSERT
  PASTRY
  CAKE
  ICE_CREAM
  BEVERAGE
  SMOOTHIE
  JUICE
  OTHER
}
